# Stage 4 configuration; no credentials here.
# This file is documentation. The application does not load .env automatically.
SUPPORT_MODEL_PROVIDER=offline

# For a local HTTP demo, supply your own value through the environment.
# STAFF_API_KEY=

# Existing upstream optional providers; not used by the Stage 0 gate.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# OPENAI_API_VERSION=2024-10-21

# DeepSeek: explicitly select SUPPORT_MODEL_PROVIDER=deepseek for paid runtime use.
# Set the key outside source control. No automatic .env loading.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_TIMEOUT=60
# DEEPSEEK_MAX_TOKENS=1024
# DEEPSEEK_TEMPERATURE=0
# DEEPSEEK_MAX_RETRIES=0
# Thinking disabled; Chat Completions only. B1 requires MAX_RETRIES=0.
# M enables TaskMemory/Context; MS adds four dynamic Skills.

# Default runtime is B1; choose M or MS explicitly. B0-compatible is historical.
SKILLMEM_VARIANT=B1
# CLI/API default to .local/db/support.sqlite; use separate files for B0 and B1.
# SUPPORT_DB=.local/db/support.sqlite
# B1 execution limits: 8 model attempts, 8 tool attempts per user turn (resume included),
# 120s per invocation excluding approval wait, 5s cooperative tool deadline.
# Evaluation CLI: --max-model-calls / --max-tool-calls / --turn-timeout / --tool-timeout.

# M-only context view: structured_memory (default), full_history, legacy_trim.
# SKILLMEM_CONTEXT_STRATEGY=structured_memory
# Total estimated window includes input, configured model output reserve, and margin.
# SKILLMEM_CONTEXT_BUDGET=16384

# Full identical SOP fairness control: evaluation --full-sop with B1 or M.
# MS uses progressive SOP disclosure and rejects --full-sop.
