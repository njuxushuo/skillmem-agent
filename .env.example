# Stage 1 configuration; no credentials here.
# This file is documentation. The application does not load .env automatically.
SUPPORT_MODEL_PROVIDER=offline

# Optional API-only checkpoint persistence (the upstream CLI does not read this).
# Create the parent directory before use. Business Store is still in memory.
# SUPPORT_DB=.local/db/support.sqlite

# For a local HTTP demo, supply your own value through the environment.
# STAFF_API_KEY=

# Existing upstream optional providers; not used by the Stage 0 gate.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# OPENAI_API_VERSION=2024-10-21

# DeepSeek: explicitly select SUPPORT_MODEL_PROVIDER=deepseek for paid runtime use.
# Set the key outside source control. No automatic .env loading.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_TIMEOUT=60
# DEEPSEEK_MAX_TOKENS=1024
# DEEPSEEK_TEMPERATURE=0
# DEEPSEEK_MAX_RETRIES=0
# Thinking disabled; Chat Completions only. Retries are logical-call internal.
# SKILLMEM_* variants/context settings remain unimplemented until later stages.
