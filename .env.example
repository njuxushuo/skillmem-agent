# offline (default, no keys) | openai | azure
SUPPORT_MODEL_PROVIDER=offline
# SQLite file for conversations, checkpoints and pending approvals (empty = in memory)
SUPPORT_DB=support.db
# Key for the staff approval endpoints. Change it.
STAFF_API_KEY=dev-staff-key

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
OPENAI_API_VERSION=2024-10-21
